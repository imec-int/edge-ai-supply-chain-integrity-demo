// Policy gate for the *source* Hugging Face model's AI-BOM, generated by the
// third-party `aibomgen-cli` tool (https://github.com/idlab-discover/aibomgen-cli) and
// evaluated natively by `cosign verify-attestation --policy` (CUE).
//
// Requires a well-formed CycloneDX machine-learning-model document AND that
// aibomgen-cli's embedded Hugging Face security scan (ClamAV/ProtectAI/pickle
// scanner/etc., see `aibomgen-cli vuln-scan`) came back clean. This is a real,
// meaningful check - not just a schema/shape assertion - and is what actually
// differs from `policy.cue` (our own compiled-model BOM has no such field).

import "list"

predicateType: "https://cyclonedx.org/bom"

predicate: metadata: component: type: "machine-learning-model"

_hasSafeScan: list.Contains(predicate.metadata.component.properties, {
	name:  "huggingface:security:overallStatus"
	value: "safe"
})
_hasSafeScan: true


